{
  "requirements_files": "core/requirements/*.md",
  "specs_dir": "specs",
  "changes_dir": "changes",
  "archive_dir": "changes/archive",
  "template_dirs": ["specs/_template", "changes/_template"],
  "test_globs": [
    "tests/**",
    "**/tests/**",
    "**/test_*.py",
    "**/*_test.py",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/e2e/**"
  ],
  "test_scan_exclude": ["tools/**"],
  "protected_for_impl": [
    "tests/**",
    "**/tests/**",
    "**/test_*.py",
    "**/*_test.py",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/e2e/**",
    "golden/**",
    "quality/**",
    "specs/**",
    "core/**",
    ".github/workflows/**",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/workflow/**",
    "docs/prompts/**",
    ".claude/**",
    ".opencode/**",
    ".github/prompts/**",
    ".github/copilot-instructions.md",
    "living-spec.json",
    "tools/**"
  ],
  "escape_hatches": [
    "unittest.skip",
    "pytest.mark.skip",
    "pytest.mark.xfail",
    "pytest.skip(",
    "it.skip(",
    "test.skip(",
    "describe.skip(",
    ".only(",
    "it.todo(",
    "test.todo(",
    "# type: ignore",
    "# noqa",
    "# pyright: ignore",
    "@ts-ignore",
    "@ts-expect-error",
    "@ts-nocheck",
    "eslint-disable",
    "biome-ignore",
    "pragma: no cover",
    "istanbul ignore"
  ],
  "code_globs": ["src/**", "app/**", "apps/**", "packages/**", "lib/**"],
  "language_check": {
    "enabled": true,
    "allow": []
  },
  "text_extensions": [
    ".md", ".py", ".ts", ".tsx", ".js", ".jsx", ".json", ".yaml", ".yml",
    ".toml", ".txt", ".cfg", ".ini", ".sh", ".css", ".html"
  ],
  "skip_dirs": [".git", "node_modules", ".venv", "venv", "dist", "build", "__pycache__", ".mypy_cache", ".pytest_cache"]
}
